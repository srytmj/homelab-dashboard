# ==========================================
# Homelab Cockpit Environment Configuration
# ==========================================

# Cockpit Web Server Port
PORT=3000
HOST=0.0.0.0

# Primary Docker Daemon (the machine this dashboard itself runs on)
DOCKER_HOST_NAME=docker-host
DOCKER_SOCKET=/var/run/docker.sock

# Additional Docker Hosts (Optional, comma-separated "name=tcp://host:port")
# Each entry needs dockerd's remote API exposed (dockerd -H tcp://0.0.0.0:2375)
# on that host, reachable only over your tailnet — never bind it on a public
# interface. Host-level CPU/RAM is not available for these, only containers.
DOCKER_HOSTS=

# Proxmox VE API Integration (Optional but Recommended for Host Hardware Telemetry)
PROXMOX_URL=https://192.168.18.224:8006
PROXMOX_NODE=pve
# Proxmox API Token format: USER@REALM!TOKENID
PROXMOX_TOKEN_ID=root@pam!cockpit
PROXMOX_TOKEN_SECRET=your-proxmox-api-secret-token-here
# Allow self-signed TLS certificates for local homelab IPs
PROXMOX_REJECT_UNAUTHORIZED=false

# Tailscale Integration (Optional: via Local Socket or Tailscale REST API)
# If left empty, a simulated Tailnet peer matrix is displayed.
TAILSCALE_SOCKET=/var/run/tailscale/tailscaled.sock
TAILSCALE_API_KEY=tskey-api-kxxxxxxxxxxxxxx
TAILSCALE_TAILNET=your-tailnet-name.ts.net

# Storage Pools & Mount Points (Comma-separated)
# These are the example dev's mounts — replace them with paths that exist on
# YOUR machine, not just the labels below. A mount that doesn't exist here
# falls back to placeholder demo data, which is only useful for development.
STORAGE_MOUNTS=/,/mnt/hdd-media,/mnt/hdd-cloud,/mnt/hdd-music

# Optional display name per mount above, same order, same count (leave an
# entry blank to auto-name just that one from its folder, e.g. "hdd media").
# STORAGE_LABELS=Root,Media Library,Nextcloud & Backups,Lossless Music
STORAGE_LABELS=

# Telemetry Poll / Broadcast Interval in Milliseconds (Default: 2000ms = 2s)
POLL_INTERVAL_MS=2000

# Force Demo Mode (Set true if you want simulated data regardless of live socket)
DEMO_MODE=false

# Git Projects page: checks GitHub for new commits on tracked repos.
# Optional — raises the unauthenticated rate limit (60/hr) and allows
# tracking private repos. A classic PAT with "repo" read access is enough.
GITHUB_TOKEN=
# How often to actually call the GitHub API per tracked project (ms).
# This is independent of POLL_INTERVAL_MS — checking every 2s would burn
# through the rate limit in seconds.
GITHUB_CHECK_INTERVAL_MS=300000

# Host directory holding every tracked project's working tree, e.g.
# GIT_PROJECTS_ROOT/myapp — pull/rebuild only works for projects that live
# under here. Bind-mounted read-write into the container at /projects.
GIT_PROJECTS_ROOT=/opt/homelab-projects

# Backup, restore and config import. Run `rclone config` on the host once,
# ahead of time, to set up whichever remote you want (Nextcloud/WebDAV, or
# Google Drive via rclone's own OAuth) — Cockpit only ever runs `rclone sync`
# against it, never handles the OAuth flow itself. Point RCLONE_CONFIG_PATH
# in docker-compose.yml at that config file. Leave BACKUP_RCLONE_REMOTE empty
# to disable backup/restore entirely — config import still works without it.
BACKUP_RCLONE_REMOTE=
# Paths inside the container to sync, comma-separated. /app/data is Cockpit's
# own config; /projects is every git project's working tree (see above).
BACKUP_SOURCE_PATHS=/app/data,/projects
# 0 disables the scheduled timer; on-demand backup from the dashboard still
# works regardless of this value.
BACKUP_INTERVAL_HOURS=0

# ==========================================
# Homelab Sentinel (Telegram & Gemini AI Companion)
# (Optional: Leave empty if you don't use Telegram)
# ==========================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
MANAGED_CONTAINERS=jellyfin,nextcloud,t3-code,nginx-proxy-manager,uptime-kuma,portainer-ce,transmission,paperless-ngx,home-assistant
