# ==========================================
# Homelab Cockpit Environment Configuration
# ==========================================

# Cockpit Web Server Port
PORT=3000
HOST=0.0.0.0

# Docker Daemon Socket (Default: /var/run/docker.sock)
DOCKER_SOCKET=/var/run/docker.sock

# Proxmox VE API Integration (Optional but Recommended for Host Hardware Telemetry)
PROXMOX_URL=https://192.168.18.224:8006
PROXMOX_NODE=pve
# Proxmox API Token format: USER@REALM!TOKENID
PROXMOX_TOKEN_ID=root@pam!cockpit
PROXMOX_TOKEN_SECRET=your-proxmox-api-secret-token-here
# Allow self-signed TLS certificates for local homelab IPs
PROXMOX_REJECT_UNAUTHORIZED=false

# Tailscale Integration (Optional: via Local Socket or Tailscale REST API)
# If left empty, a simulated Tailnet peer matrix is displayed.
TAILSCALE_SOCKET=/var/run/tailscale/tailscaled.sock
TAILSCALE_API_KEY=tskey-api-kxxxxxxxxxxxxxx
TAILSCALE_TAILNET=your-tailnet-name.ts.net

# Storage Pools & Mount Points (Comma-separated)
STORAGE_MOUNTS=/,/mnt/hdd-media,/mnt/hdd-cloud,/mnt/hdd-music

# Telemetry Poll / Broadcast Interval in Milliseconds (Default: 2000ms = 2s)
POLL_INTERVAL_MS=2000

# Force Demo Mode (Set true if you want simulated data regardless of live socket)
DEMO_MODE=false

# ==========================================
# Homelab Sentinel (Telegram & Gemini AI Companion)
# (Optional: Leave empty if you don't use Telegram)
# ==========================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
MANAGED_CONTAINERS=jellyfin,nextcloud,t3-code,nginx-proxy-manager,uptime-kuma,portainer-ce,transmission,paperless-ngx,home-assistant
